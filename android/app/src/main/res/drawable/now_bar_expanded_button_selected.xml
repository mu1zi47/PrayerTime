<?xml version="1.0" encoding="utf-8"?>
<!-- The expanded card's mark button once the prayer is logged: filled,
     with the check on it in the fill's opposite — "selected", rather than
     turning into an undo button. Tapping it again still clears the mark.
     Gold on the light card, white on the dark theme's gold one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/now_bar_expanded_button_selected_bg" />
</shape>
