<?xml version="1.0" encoding="utf-8"?>
<!-- The "logged" skin for the whole panel, the way One UI's alarm widget
     turns solid-colored when an alarm is on and falls back to a plain light
     panel when none is. Same in both themes: this teal reads on either. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="46dp" />
    <solid android:color="@color/widget_marked_bg" />
</shape>
