<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar chip's content (`chipExpandedView`, see
     PrayerStatusNotifier's Samsung extras): the crescent and the countdown,
     the way Samsung Clock's stopwatch chip shows its icon and time.

     One UI drops its own icon for a chip built from an app's view, so the
     crescent is drawn here. It also frames such a chip in its own
     translucent grey whatever chip color the notification gives, so this
     view leaves the background to it — a gold pill of our own only sat
     inside that grey frame. It adds this view with default layout params,
     which fill the chip's height.

     White, in One UI's fixed-width digits so the chip doesn't jitter in
     width as it ticks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_now_bar_chip" />

    <Chronometer
        android:id="@+id/now_bar_chip_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sec-num-fixed"
        android:maxLines="1"
        android:singleLine="true"
        android:textColor="#FFFFFFFF"
        android:textFontWeight="600"
        android:textSize="14dp"
        tools:ignore="SpUsage,UnusedAttribute" />
</LinearLayout>
