<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/now_bar_exp_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/now_bar_expanded_bg" android:clipToOutline="true" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="@dimen/now_bar_vertical_padding" android:paddingBottom="@dimen/now_bar_vertical_padding">
    <LinearLayout android:id="@+id/now_bar_exp_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:clipToOutline="true" android:minHeight="@dimen/now_bar_header_min_height">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="0dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/now_bar_exp_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/exo2" android:maxLines="1" android:textColor="@color/now_bar_expanded_text" android:textSize="20sp" android:includeFontPadding="false" android:textStyle="bold" />
            <TextView android:id="@+id/now_bar_exp_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/now_bar_expanded_text_muted" android:textSize="12sp" android:fontFamily="@font/nunito" android:includeFontPadding="false" />
        </LinearLayout>
        <Chronometer android:fontFeatureSettings="tnum" android:id="@+id/now_bar_exp_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="@font/exo2" android:maxLines="1" android:textColor="@color/now_bar_widget_countdown" android:textSize="18sp" android:includeFontPadding="false" />
        <FrameLayout android:id="@+id/now_bar_exp_button" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp">
            <ImageView android:id="@+id/now_bar_exp_button_icon" android:layout_width="@dimen/now_bar_button_diameter" android:layout_height="@dimen/now_bar_button_diameter" android:background="@drawable/now_bar_expanded_circle" android:padding="@dimen/now_bar_button_icon_padding" android:src="@drawable/ic_now_bar_check" android:layout_gravity="center" android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/now_bar_exp_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
</LinearLayout>