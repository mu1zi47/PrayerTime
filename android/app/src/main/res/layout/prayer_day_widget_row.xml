<?xml version="1.0" encoding="utf-8"?>
<!-- One slot of the day in the 4x2 widget. Weighted rather than fixed in
     height, so all six share whatever the placed widget is tall — a resized
     cell stretches the rows instead of cutting the last one off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_widget_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/day_widget_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/day_widget_row_check"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_check_plain"
        android:visibility="gone" />

    <TextView
        android:id="@+id/day_widget_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp" />
</LinearLayout>
