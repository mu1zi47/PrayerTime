<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/next_widget_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bg_light"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToOutline="true"

        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <Chronometer
            android:fontFeatureSettings="tnum"
            android:id="@+id/next_widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/exo2"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_accent2"
            android:textSize="30sp"
            android:gravity="start"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/next_widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:gravity="start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="14sp"
            android:fontFamily="@font/nunito" />
    </LinearLayout>
</FrameLayout>
