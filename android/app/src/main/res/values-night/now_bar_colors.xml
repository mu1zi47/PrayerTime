<?xml version="1.0" encoding="utf-8"?>
<!-- Only what's drawn on One UI's own card follows the system here — see
     values/now_bar_colors.xml for why.

     In the dark theme the card is gold rather than One UI's dark grey: that
     is what the same Now Bar looks like on the lock screen, where One UI
     fills its card with the notification's own color, and the two reading
     differently in the shade looked like two different apps. The light
     theme keeps One UI's light card — gold on a bright shade would shout. -->
<resources>
    <color name="now_bar_button_glyph">#FAFAFF</color>

    <!-- Deep gold for the fill, a brighter one for the corner glow, so the
         card carries the same top-left-to-bottom-right fade as the lock
         screen's. -->
    <color name="now_bar_expanded_card">#A9802E</color>
    <color name="now_bar_expanded_glow">#CCD9B45F</color>

    <color name="now_bar_expanded_text">#FFFFFF</color>
    <color name="now_bar_expanded_text_muted">#B3FFFFFF</color>

    <!-- White washes, not gold ones: gold on gold is invisible. -->
    <color name="now_bar_expanded_button_bg">#33FFFFFF</color>
    <color name="now_bar_expanded_highlight">#2EFFFFFF</color>
    <color name="now_bar_expanded_icon_bg">#33FFFFFF</color>
    <color name="now_bar_expanded_button_selected_bg">#FFFFFF</color>
    <color name="now_bar_expanded_button_selected_glyph">#A9802E</color>

    <color name="prayer_schedule_text">#E6E6EB</color>
</resources>
