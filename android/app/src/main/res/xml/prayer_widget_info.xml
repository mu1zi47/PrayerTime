<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 by default: the layout is a single row of content, so a taller cell
     would just leave empty space under it. minHeight follows the platform's
     70 * cells - 30 sizing rule. Still resizable both ways for anyone who
     wants it roomier — the content stays vertically centered. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/prayer_widget"
    android:minHeight="40dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/prayer_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
